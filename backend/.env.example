# Campus Hub Backend Environment Variables
# Copy this file to .env and update values

# Server
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campus_hub

# JWT
JWT_SECRET=campus_hub_jwt_secret_key_2024_change_in_production
JWT_EXPIRES_IN=7d

# CORS (Single URL or comma-separated list of URLs)
# Note: All *.vercel.app URLs are automatically supported out of the box
FRONTEND_URL=https://frontend-kdk6ow4e2-ruchirkalra668-3230s-projects.vercel.app,http://localhost:5173
CORS_ORIGIN=https://frontend-kdk6ow4e2-ruchirkalra668-3230s-projects.vercel.app
